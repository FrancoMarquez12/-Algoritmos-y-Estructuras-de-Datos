
matriz_cuadrada = [
    [4.0, 7.0],
    [2.0, 6.0]
]

def inversa_matriz_2x2(matriz):

    a, b = matriz[0][0], matriz[0][1]
    c, d = matriz[1][0], matriz[1][1]

    determinante = (a * d) - (b * c)
    if determinante == 0:
        return "La matriz no tiene inversa"
    
    inversa = [
        [d / determinante, -b / determinante],
        [-c / determinante, a / determinante]
    ]
    return inversa

print("Matriz inversa de 2x2:")
print(inversa_matriz_2x2(matriz_cuadrada))
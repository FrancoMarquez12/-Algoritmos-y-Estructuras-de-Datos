using System;
using System.IO;

class Program
{
    static void Main()
    {
        string ruta = "diario.txt";
        Console.Write("Ingrese su nombre: ");
        string nombre = Console.ReadLine();
        Console.Write("Ingrese su frase favorita: ");
        string frase = Console.ReadLine();

        using (StreamWriter sw = new StreamWriter(ruta, false))
        {
            sw.WriteLine($"Usuario: {nombre}");
            sw.WriteLine($"Frase: {frase}");
        }
        using (StreamWriter sw = new StreamWriter(ruta, true))
        {
            sw.WriteLine($"Ultima actualizacion: {DateTime.Now}");
        }
        Console.WriteLine("Archivo guardado correctamente.");
    }
}

using System;
using System.IO;
class Program
{
static void Main()
{
string ruta = "diario.txt";
// Paso 1: Sobrescribir o crear el archivo (append = false)
using (StreamWriter sw = new StreamWriter(ruta))
{
sw.WriteLine("--- DIARIO PERSONAL ---");

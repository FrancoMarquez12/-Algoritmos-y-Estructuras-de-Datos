
mi_matriz = [
    [1, 2, 3],
    [4, 99, 6],
    [7, 8, 9]
]

def posicion_maximo_absoluto(matriz):
    max_elemento = matriz[0][0]
    posicion = (0, 0)
    
    for i in range(len(matriz)):
        for j in range(len(matriz[i])):
            if matriz[i][j] > max_elemento:
                max_elemento = matriz[i][j]
                posicion = (i, j)
    return posicion

print("Posicion (fila, col) del maximo:", posicion_maximo_absoluto(mi_matriz))
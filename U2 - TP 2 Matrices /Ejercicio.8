using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { 5, 12, 8 },
            { 3, 19, 21 }
        };

        var res1 = BuscarEntero(miMatriz, 19);
        Console.WriteLine("Posicion del 19: " + (res1.HasValue ? $"({res1.Value.fila}, {res1.Value.col})" : "None"));

        var res2 = BuscarEntero(miMatriz, 100);
        Console.WriteLine("Posicion del 100: " + (res2.HasValue ? $"({res2.Value.fila}, {res2.Value.col})" : "None"));
    }

    static (int fila, int col)? BuscarEntero(int[,] matriz, int valor)
    {
        int filas = matriz.GetLength(0);
        int columnas = matriz.GetLength(1);

        for (int i = 0; i < filas; i++)
        {
            for (int j = 0; j < columnas; j++)
            {
                if (matriz[i, j] == valor)
                {
                    return (i, j);
                }
            }
        }

        return null;
    }
}

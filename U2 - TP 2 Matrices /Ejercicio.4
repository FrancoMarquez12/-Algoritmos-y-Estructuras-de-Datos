using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { 10, 5 },
            { 42, 0 },
            { 3, 33 }
        };

        Console.WriteLine("Fila del maximo en columna 1: " + FilaMaximoEnColumna(miMatriz, 1));
    }

    static int FilaMaximoEnColumna(int[,] matriz, int indiceColumna)
    {
        int maxElemento = matriz[0, indiceColumna];
        int idxFila = 0;

        int filas = matriz.GetLength(0);

        for (int i = 1; i < filas; i++)
        {
            if (matriz[i, indiceColumna] > maxElemento)
            {
                maxElemento = matriz[i, indiceColumna];
                idxFila = i;
            }
        }

        return idxFila;
    }
}

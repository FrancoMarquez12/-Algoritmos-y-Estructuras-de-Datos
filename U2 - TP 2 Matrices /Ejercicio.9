using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { 1, 1, 1 },
            { 10, 20, 30 }
        };

        Console.WriteLine("Suma de la fila 1: " + SumaFila(miMatriz, 1));
    }

    static int SumaFila(int[,] matriz, int indiceFila)
    {
        int suma = 0;
        int columnas = matriz.GetLength(1);

        for (int j = 0; j < columnas; j++)
        {
            suma += matriz[indiceFila, j];
        }

        return suma

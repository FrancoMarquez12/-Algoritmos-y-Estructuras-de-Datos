using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { 1, 5, 3 },
            { 2, 10, 4 }
        };

        Console.WriteLine("Suma de la columna 1: " + SumaColumna(miMatriz, 1));
    }

    static int SumaColumna(int[,] matriz, int indiceColumna)
    {
        int suma = 0;
        int filas = matriz.GetLength(0);

        for (int i = 0; i < filas; i++)
        {
            suma += matriz[i, indiceColumna];
        }

        return suma;
    }
}

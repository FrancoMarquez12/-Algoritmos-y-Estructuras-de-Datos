mi_matriz = [
    [-1, 2, 0],
    [4, -5, 6]
]

def contar_positivos(matriz):
    contador = 0
    for fila in matriz:
        for elemento in fila:
            if elemento > 0:
                contador += 1
    return contador

print("Cantidad de positivos:", contar_positivos(mi_matriz))

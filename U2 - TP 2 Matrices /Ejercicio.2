using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { -1, 2, 0 },
            { 4, -5, 6 }
        };

        Console.WriteLine("Cantidad de positivos: " + ContarPositivos(miMatriz));
    }

    static int ContarPositivos(int[,] matriz)
    {
        int contador = 0;

        for (int i = 0; i < matriz.GetLength(0); i++)
        {
            for (int j = 0; j < matriz.GetLength(1); j++)
            {
                if (matriz[i, j] > 0)
                {
                    contador++;
                }
            }
        }

        return contador;
    }
}

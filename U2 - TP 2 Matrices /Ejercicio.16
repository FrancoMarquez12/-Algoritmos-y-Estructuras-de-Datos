
matriz_A = [[1.5, 2.0], [3.0, 4.0]]
matriz_B = [[0.5, 1.0], [2.0, 1.0]]

def restar_matrices(A, B):
    filas = len(A)
    columnas = len(A[0])
    resultado = [[0.0 for _ in range(columnas)] for _ in range(filas)]
    
    for i in range(filas):
        for j in range(columnas):
            resultado[i][j] = A[i][j] - B[i][j]
    return resultado

print("Resta de matrices A - B:", restar_matrices(matriz_A, matriz_B))

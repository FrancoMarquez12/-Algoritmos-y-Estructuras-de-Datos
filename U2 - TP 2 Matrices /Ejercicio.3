using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { 10, 42, 3 },
            { 5, 0, 33 }
        };

        Console.WriteLine("Columna del maximo en fila 0: " + ColumnaMaximoEnFila(miMatriz, 0));
    }

    static int ColumnaMaximoEnFila(int[,] matriz, int indiceFila)
    {
        int maxElemento = matriz[indiceFila, 0];
        int idxColumna = 0;
        int columnas = matriz.GetLength(1);

        for (int j = 1; j < columnas; j++)
        {
            if (matriz[indiceFila, j] > maxElemento)
            {
                maxElemento = matriz[indiceFila, j];
                idxColumna = j;
            }
        }

        return idxColumna;
    }
}

using System;

class Program
{
    static void Main()
    {
        int[,] miMatriz = {
            { 1, 2, 3 },
            { 4, 5, 6 }
        };

        Console.WriteLine("Suma total: " + SumaMatriz(miMatriz));
    }

    static int SumaMatriz(int[,] matriz)
    {
        int suma = 0;

        for (int i = 0; i < matriz.GetLength(0); i++)
        {
            for (int j = 0; j < matriz.GetLength(1); j++)
            {
                suma += matriz[i, j];
            }
        }

        return suma;
    }
}
